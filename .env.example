# Konfigurasi LLM Universal (Bisa OpenAI, Groq, RunPod, Ollama, DeepSeek, Together, dll)
# Default contoh di bawah menggunakan Groq:
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_your_key_here
LLM_MODEL=openai/gpt-oss-120b

# Contoh jika ingin pakai OpenAI resmi:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-proj-xxxx
# LLM_MODEL=gpt-4o-mini

# Contoh jika ingin pakai Ollama lokal (tanpa internet / laptop sendiri):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.1
